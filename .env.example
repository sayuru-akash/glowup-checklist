# Google Identity Services web client ID.
# Add http://localhost and http://localhost:3000 as Authorized JavaScript origins for local testing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# At least 32 random bytes for signed session cookies.
AUTH_SECRET=

# Local/dev only. Production ignores preview auth even if set.
PREVIEW_AUTH_ENABLED=false

# Google AI API key from Google AI Studio. Kept server-side only.
GEMINI_API_KEY=

# Defaults track Google AI docs checked on 2026-05-18; override when Google moves previews.
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel Marketplace Neon Postgres or any separate Neon database for this app.
# The app also accepts POSTGRES_URL when Vercel injects that name.
DATABASE_URL=

# Backblaze B2 S3-compatible bucket for generated artwork.
# Image generation fails loudly when these are missing.
B2_BUCKET=glowup-web-img-store
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional. Use only when serving through a public Friendly URL or CDN instead of /api/media.
B2_PUBLIC_BASE_URL=
